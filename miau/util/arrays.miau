arrayCreate():
    object array
    var array["length"] = 0

    return array

arrayAdd(array, val):
    var array["length"] = array["length"] + 1
    var i = array["length"]
    var array[i] = val

    return array

arrayRemove(array, i):
    var idx = i + 1

    while (idx <= array["length"]) do:
        var array[i] = array[idx]
        var i = i + 1
        var idx = idx + 1
    done

    var len = array["length"]
    var newLen = len - 1
    var array["length"] = newLen

    remove array[i]
    return array

arrayPrint(array):
     var i = 1
     var len = array["length"]

     if (len < 1) then:
         meow "[]"
         return
     end

     purr "["
     purr array[1]

     while (i < len) do:
         var i = i + 1
         purr ", "
         purr array[i]
     done

     meow "]"
     return

arrayShiftRight(array):
    var i = array["length"]
    while (i > 1) do:
        var prev = i - 1
        var val = array[prev]
        var array[i] = val
        var i = i - 1
    done
    return

arrayContains(array, value):
    var i = 1
    var len = array["length"]
    while (i <= len) do:
        var item = array[i]
        if (item == value) then: return 1
        var i = i + 1
    done
    return 0

arrayIndexOf(array, value):
    var i = 1
    var len = array["length"]
    while (i <= len) do:
        var item = array[i]
        if (item == value) then: return i
        var i = i + 1
    done
    return -1

arrayClear(array):
    var i = 1
    var len = array["length"]
    while (i <= len) do:
        remove array[i]
        var i = i + 1
    done
    var array["length"] = 0
    return

arrayInsert(array, index, value):
    var len = array["length"]

    if (index < 1 | index > len + 1) then: return

    var array["length"] = len + 1
    var i = array["length"]

    while (i > index) do:
        var prev = i - 1
        var val = array[prev]
        var array[i] = val
        var i = i - 1
    done

    var array[index] = value
    return

arraySwap(array, i, j):
    var temp = array[i]
    var array[i] = array[j]
    var array[j] = temp
    return