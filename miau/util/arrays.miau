arrayCreate():
    object array
    var array["length"] = 0

    return array

arrayAdd(array, var):
    var array["length"] = array["length"] + 1
    var i = array["length"]
    var array[i] = var

    return array

arrayRemove(array, i):
    var index = i + 1

    while (index <= array["length"]) do:
        var array[i] = array[index]
        var i = i + 1
        var index = index + 1
    end

    var array["length"] = array["length"] - 1
    remove array[i]
    return

arrayPrint(array):
    var i = 1

    if (i >= array["length"]) then:
        return
    end

    purr ("[")
    purr (array[i])
    purr (", ")

    while (i < array["length"]) do:
        var i = i + 1
        purr (array[i])

        if (i == array["length"] - 1) then:
            purr (", ")
        end
    end

    meow ("]")
    return