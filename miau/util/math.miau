__init:
    const PI = 3.14159265
    const E = 2.71828182
    return

mathAbs(x):
    if (x < 0) then:
        return 0 - x
    end
    return x

mathFloor(x):
    var remainderVal = x % 1
    var res = x - remainderVal
    if (x < 0 & remainderVal != 0) then:
        return res - 1
    end
    return res

mathSqrt(x):
    if (x == 0) then:
        return 0
    end

    var estimateVal = x / 2
    var loopI = 0

    while (loopI < 6) do:
        var divisionVal = x / estimateVal
        var sumVal = estimateVal + divisionVal
        var estimateVal = sumVal / 2
        var loopI = loopI + 1
    done

    return estimateVal

mathSin(x):
    var adjustedX = x % 6.28318530

    if (adjustedX > 3.14159265) then:
        var adjustedX = adjustedX - 6.28318530
    end

    if (adjustedX < -3.14159265) then:
        var adjustedX = adjustedX + 6.28318530
    end

    var powerX3 = adjustedX ^ 3
    var powerX5 = adjustedX ^ 5
    var termTwo = powerX3 / 6
    var termThree = powerX5 / 120
    var subVal = adjustedX - termTwo
    return subVal + termThree

mathCos(x):
    var cosAngle = x + 1.57079632
    call mathSin(cosAngle) : res
    return res

mathClamp(val, minVal, maxVal):
    if (val < minVal) then:
        return minVal
    end
    if (val > maxVal) then:
        return maxVal
    end
    return val