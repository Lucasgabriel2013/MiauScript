#copycat "util/arrays.miau"

__init:
    # --- Player ---
    global playerX = 10.0
    global playerY = 30.0
    const playerW = 5
    const playerH = 5
    global velX = 0.0
    global velY = 0.0
    global noChao = 0

    # --- Viewport (Camera) ---
    global cameraX = 0.0
    const screenWidth = 100.0
    const mapWidth = 300.0

    # --- Constantes de Fisica ---
    const gravidade = 0.35
    const forcaPulo = -3.5
    const friccao = 0.82
    const acel = 0.25

    # --- Status e Progresso ---
    global score = 0
    global lives = 3
    global currentLevel = 1
    global playing = 1
    global winGame = 0
    global tick = 0

    # --- Posicao da Bandeira (Final do Nivel) ---
    global flagX = 280.0
    global flagY = 22.0

    # --- Listas ---
    arrayCreate() : platList
    global platforms = platList

    arrayCreate() : coinList
    global coins = coinList

    arrayCreate() : enemyList
    global enemies = enemyList

    # Carregar o Primeiro Nivel
    carregarFase(1)
    return

