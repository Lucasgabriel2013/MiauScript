playSound():
    while (1) do:
        spawn mario
        sleep 14500
    done
    return

coinSound():
    # Primeira nota rápida (Si)
    sound 987.77, 80

    # Segunda nota mais longa (Mí)
    sound 1318.51, 300
    return

nextLevelSound():
    sound 523.25, 100
    sound 659.25, 100
    sound 783.99, 100
    sound 1046.50, 350
    return

AddPlat(px, py, pw, ph):
    object p
    var p["x"] = px
    var p["y"] = py
    var p["w"] = pw
    var p["h"] = ph
    arrayAdd(platforms, p)
    return

spawnMoedaPlat(mx, my):
    object m
    var m["x"] = mx
    var m["y"] = my
    var m["active"] = 1
    arrayAdd(coins, m)
    return

spawnInimigo(ex, ey, rMin, rMax):
    object e
    var e["x"] = ex
    var e["y"] = ey
    var e["w"] = 4.0
    var e["h"] = 4.0
    var e["dir"] = 1.0
    var e["speed"] = 0.3
    var e["minX"] = rMin
    var e["maxX"] = rMax
    var e["active"] = 1
    arrayAdd(enemies, e)
    return

carregarFase(lvl):
    arrayClear(platforms)
    arrayClear(coins)
    arrayClear(enemies)

    global playerX = 10.0
    global playerY = 30.0
    global velX = 0.0
    global velY = 0.0
    global cameraX = 0.0

    # FASE 1: Superficie (Dividido em blocos para nao sumir na camera)
    if (lvl == 1) then:
        AddPlat(0.0, 42.0, 100.0, 8.0)
        AddPlat(100.0, 42.0, 100.0, 8.0)
        AddPlat(200.0, 42.0, 100.0, 8.0)

        AddPlat(30.0, 32.0, 25.0, 3.0)
        AddPlat(70.0, 24.0, 30.0, 3.0)
        AddPlat(120.0, 30.0, 25.0, 3.0)
        AddPlat(160.0, 20.0, 30.0, 3.0)
        AddPlat(210.0, 28.0, 25.0, 3.0)

        spawnMoedaPlat(35.0, 28.0)
        spawnMoedaPlat(80.0, 20.0)
        spawnMoedaPlat(130.0, 26.0)
        spawnMoedaPlat(170.0, 16.0)
        spawnMoedaPlat(220.0, 24.0)

        spawnInimigo(80.0, 38.0, 60.0, 110.0)
        spawnInimigo(170.0, 38.0, 150.0, 200.0)
    end

    # FASE 2: Caverna Subterrânea (Com Abismos)
    if (lvl == 2) then:
        AddPlat(0.0, 42.0, 80.0, 8.0)
        AddPlat(110.0, 42.0, 80.0, 8.0)
        AddPlat(210.0, 42.0, 90.0, 8.0)

        AddPlat(85.0, 32.0, 20.0, 3.0)
        AddPlat(140.0, 25.0, 25.0, 3.0)
        AddPlat(190.0, 30.0, 18.0, 3.0)
        AddPlat(240.0, 22.0, 25.0, 3.0)

        spawnMoedaPlat(90.0, 28.0)
        spawnMoedaPlat(125.0, 38.0)
        spawnMoedaPlat(150.0, 21.0)
        spawnMoedaPlat(195.0, 26.0)
        spawnMoedaPlat(250.0, 18.0)

        spawnInimigo(30.0, 38.0, 15.0, 65.0)
        spawnInimigo(130.0, 38.0, 115.0, 175.0)
        spawnInimigo(230.0, 38.0, 215.0, 270.0)
    end

    # FASE 3: Castelo de Lava
    if (lvl == 3) then:
        AddPlat(0.0, 42.0, 35.0, 8.0)
        AddPlat(50.0, 34.0, 20.0, 3.0)
        AddPlat(80.0, 26.0, 20.0, 3.0)
        AddPlat(110.0, 34.0, 25.0, 3.0)
        AddPlat(145.0, 22.0, 20.0, 3.0)
        AddPlat(175.0, 30.0, 25.0, 3.0)
        AddPlat(210.0, 22.0, 20.0, 3.0)
        AddPlat(240.0, 34.0, 20.0, 3.0)
        AddPlat(270.0, 42.0, 30.0, 8.0)

        spawnMoedaPlat(55.0, 30.0)
        spawnMoedaPlat(85.0, 22.0)
        spawnMoedaPlat(150.0, 18.0)
        spawnMoedaPlat(215.0, 18.0)
        spawnMoedaPlat(275.0, 38.0)

        spawnInimigo(115.0, 30.0, 112.0, 130.0)
        spawnInimigo(180.0, 26.0, 177.0, 195.0)
    end
    return

lerTeclado():
    keyboard "A"
    keyboard "D"
    keyboard "W"
    keyboard "SPACE"

    if (A) then:
        global velX = velX - acel
        if (W) then: global velX = velX - acel / 1.5
    end

    if (D) then:
        global velX = velX + acel
        if (W) then: global velX = velX + acel / 1.5
    end

    if (SPACE & noChao) then:
        global velY = forcaPulo
        global noChao = 0
    end
    return

perderVida():
    global lives = lives - 1
    if (lives <= 0) then:
        global playing = 0
    end
    if (lives > 0) then:
        global playerX = 10.0
        global playerY = 30.0
        global velX = 0.0
        global velY = 0.0
    end
    return

aplicarFisicaEColisao():
    global velY = velY + gravidade
    global velX = velX * friccao

    global playerX = playerX + velX

    var limitRight = mapWidth - playerW
    mathClamp(playerX, 0, limitRight) : clampedX
    global playerX = clampedX

    global playerY = playerY + velY
    global noChao = 0

    if (playerY > 52.0) then:
        perderVida()
    end

    var i = 1
    var len = platforms["length"]
    while (i <= len) do:
        var plat = platforms[i]

        checkCollision(playerX, playerY, playerW, playerH, plat["x"], plat["y"], plat["w"], plat["h"]) : colidiu

        if (colidiu) then:
            var platY = plat["y"]
            var topY = platY - playerH

            var prevY = playerY - velY
            var prevFeet = prevY + playerH

            if (velY > 0.0 & prevFeet <= platY + 2.0) then:
                global playerY = topY
                global velY = 0.0
                global noChao = 1
            end

            if (velY < 0.0 & prevY >= platY) then:
                var platH = plat["h"]
                var bottomY = platY + platH
                global playerY = bottomY
                global velY = 0.0
            end
        end
        var i = i + 1
    done
    return

atualizarInimigos():
    var i = 1
    var len = enemies["length"]
    while (i <= len) do:
        var e = enemies[i]
        if (e["active"]) then:
            var ex = e["x"]
            var edir = e["dir"]
            var espd = e["speed"]
            var step = edir * espd
            var nextX = ex + step
            var e["x"] = nextX

            var minX = e["minX"]
            var maxX = e["maxX"]
            if (nextX <= minX) then:
                var e["dir"] = 1.0
            end
            if (nextX >= maxX) then:
                var e["dir"] = -1.0
            end

            checkCollision(playerX, playerY, playerW, playerH, e["x"], e["y"], e["w"], e["h"]) : col
            if (col) then:
                var ey = e["y"]
                var py = playerY
                var pyBottom = py + playerH
                var eyTop = ey + 2.0

                if (velY > 0.0 & pyBottom <= eyTop) then:
                    var e["active"] = 0
                    global velY = -2.5
                    global score = score + 200
                end
                if (velY <= 0.0 | pyBottom > eyTop) then:
                    perderVida()
                end
            end
        end
        var i = i + 1
    done
    return

verificarBandeira():
    checkCollision(playerX, playerY, playerW, playerH, flagX, flagY, 4.0, 20.0) : chegou
    if (chegou) then:
        spawn nextLevelSound
        global score = score + 500
        global currentLevel = currentLevel + 1

        if (currentLevel > 3) then:
            global winGame = 1
            global playing = 0
        end
        if (currentLevel <= 3) then:
            carregarFase(currentLevel)
        end
    end
    return

atualizarCamera():
    var targetCamX = playerX - 47.5
    var camMax = mapWidth - screenWidth
    mathClamp(targetCamX, 0, camMax) : clampedCamX
    global cameraX = clampedCamX
    return

checarMoedas():
    var i = 1
    var len = coins["length"]

    while (i <= len) do:
        var c = coins[i]
        if (c["active"]) then:
            checkCollision(playerX, playerY, playerW, playerH, c["x"], c["y"], 3.0, 3.0) : pegou

            if (pegou) then:
                var c["active"] = 0
                spawn coinSound
                global score = score + 100
            end
        end
        var i = i + 1
    done
    return

desenharCenario():
    if (currentLevel == 1) then: paintAll(100, 180, 255)
    if (currentLevel == 2) then: paintAll(20, 15, 30)
    if (currentLevel == 3) then: paintAll(35, 10, 15)

    if (currentLevel == 3) then:
        paintRect(0, 48, 100, 2, 255, 60, 0)
    end

    var i = 1
    var pLen = platforms["length"]
    while (i <= pLen) do:
        var plat = platforms[i]
        var platX = plat["x"]
        var renderX = platX - cameraX
        var renderY = plat["y"]
        var pw = plat["w"]
        var ph = plat["h"]

        # CORREÇÃO: Limite ampliado (-300.0) para cobrir a largura das plataformas
        if (renderX > -300.0 & renderX < 100.0) then:
            if (currentLevel == 1) then:
                paintRect(renderX, renderY, pw, ph, 120, 70, 30)
                paintRect(renderX, renderY, pw, 1.0, 50, 200, 50)
            end
            if (currentLevel == 2) then:
                paintRect(renderX, renderY, pw, ph, 60, 55, 75)
                paintRect(renderX, renderY, pw, 1.0, 140, 100, 180)
            end
            if (currentLevel == 3) then:
                paintRect(renderX, renderY, pw, ph, 70, 30, 30)
                paintRect(renderX, renderY, pw, 1.0, 200, 50, 50)
            end
        end
        var i = i + 1
    done

    var j = 1
    var cLen = coins["length"]
    while (j <= cLen) do:
        var c = coins[j]
        if (c["active"]) then:
            var coinX = c["x"]
            var renderX = coinX - cameraX
            var renderY = c["y"]

            if (renderX > -5.0 & renderX < 100.0) then:
                paintOval(renderX, renderY, 3, 3, 255, 220, 0)
            end
        end
        var j = j + 1
    done

    var k = 1
    var eLen = enemies["length"]
    while (k <= eLen) do:
        var e = enemies[k]
        if (e["active"]) then:
            var ex = e["x"]
            var renderX = ex - cameraX
            var renderY = e["y"]

            if (renderX > -5.0 & renderX < 100.0) then:
                paintOval(renderX, renderY, 4, 4, 160, 60, 20)
                paintPixel(renderX + 1.0, renderY + 1.0, 255, 255, 255)
            end
        end
        var k = k + 1
    done

    var fRenderX = flagX - cameraX
    if (fRenderX > -10.0 & fRenderX < 100.0) then:
        paintRect(fRenderX, flagY, 2, 20, 200, 200, 200)
        paintRect(fRenderX + 2.0, flagY, 6, 4, 255, 30, 30)
    end

    var px = playerX - cameraX
    var py = playerY
    paintRect(px, py, playerW, playerH, 220, 50, 50)

    var eyeY = py + 1.0
    if (velX >= 0.0) then:
        var eyeX = px + 3.0
        paintPixel(eyeX, eyeY, 255, 255, 255)
    end
    if (velX < 0.0) then:
        var eyeX = px + 1.0
        paintPixel(eyeX, eyeY, 255, 255, 255)
    end

    var v = 1
    while (v <= lives) do:
        var vMinus = v - 1
        var vShift = vMinus * 4
        var vx = 2.0 + vShift
        paintRect(vx, 2.0, 3.0, 3.0, 255, 50, 50)
        var v = v + 1
    done

    paintRect(85.0, 2.0, 12.0, 4.0, 40, 40, 60)
    var l = 1
    while (l <= currentLevel) do:
        var lMinus = l - 1
        var lShift = lMinus * 3.0
        var lx = 86.0 + lShift
        paintRect(lx, 3.0, 2.0, 2.0, 255, 220, 0)
        var l = l + 1
    done

    repaint
    return

main():
    meow "--- SUPER MIAU BROS 3D ---"
    meow "Chegue ate a bandeira no final para passar de fase!"

    spawn playSound

    while (playing) do:
        global tick = tick + 1

        lerTeclado()
        aplicarFisicaEColisao()
        atualizarInimigos()
        atualizarCamera()
        checarMoedas()
        verificarBandeira()
        desenharCenario()

        sleep 16
    done

    paintAll(0, 0, 0)
    repaint

    if (winGame) then:
        meow "PARABENS! VOCE ZEROUS OS 3 NIVEIS DO SUPER MIAU BROS!"
    end
    if (winGame == 0) then:
        meow "GAME OVER! Tente novamente!"
    end
