#copycat "screen/paint.miau"
#copycat "screen/physics.miau"
#copycat "util/math.miau"

__init:
    global p1Y = 20.0
    global p2Y = 20.0
    global ballX = 50.0
    global ballY = 24.0
    global ballVX = 0.9
    global ballVY = 0.3
    global score1 = 0
    global score2 = 0
    global playing = 1
    return

lerControles():
    keyboard "W"
    keyboard "S"

    if (W) then:
        mathClamp(p1Y - 1.5, 0, 40) : res
        global p1Y = res
    end

    if (S) then:
        mathClamp(p1Y + 1.5, 0, 40) : res
        global p1Y = res
    end
    return

moverIA():
    # Persegue a bola suavemente aplicando a lógica do mathClamp
    var dir = 0.0
    var targetY = ballY - 4

    if (p2Y < targetY) then: var dir = 1.0
    if (p2Y > targetY) then: var dir = -1.0

    mathClamp(p2Y + dir, 0, 40) : res
    global p2Y = res
    return

verificarColisoes():
    # Teto / Chão
    if (ballY <= 0 | ballY >= 48) then:
        mathClamp(ballY, 0, 48) : res
        global ballY = res
        global ballVY = ballVY * -1
    end

    # Colisão Raquete Esquerda (P1)
    checkCollision(ballX, ballY, 2, 2, 4, p1Y, 2, 10)
    if (result == 1) then:
        global ballX = 6.0
        global ballVX = ballVX * -1
        global ballVY = ballVY + 0.2
    end

    # Colisão Raquete Direita (P2)
    checkCollision(ballX, ballY, 2, 2, 94, p2Y, 2, 10)
    if (result == 1) then:
        global ballX = 92.0
        global ballVX = ballVX * -1
        global ballVY = ballVY - 0.2
    end

    # Pontuação e Reset
    if (ballX < 0 | ballX > 98) then:
        if (ballX < 0) then: global score2 = score2 + 1
        if (ballX > 98) then: global score1 = score1 + 1

        global ballX = 50.0
        global ballY = 24.0
        global ballVX = ballVX * -1
    end

    if (score1 == 5 | score2 == 5) then: global playing = 0
    return

desenharTela():
    paintAll(0, 0, 0)
    paintRect(49, 0, 2, 50, 100, 100, 100)
    paintRect(4, p1Y, 2, 10, 50, 150, 255)
    paintRect(94, p2Y, 2, 10, 255, 50, 50)
    paintRect(ballX, ballY, 2, 2, 255, 255, 255)
    repaint
    return

main():
    meow "--- INICIANDO MIAU PONG ---"
    while (playing) do:
        lerControles()
        moverIA()

        # Física & Movimento da Bola
        global ballX = ballX + ballVX
        global ballY = ballY + ballVY

        verificarColisoes()
        desenharTela()
        sleep 16
    done

    paintAll(0, 0, 0)
    repaint
    meow "GAME OVER!"
    purr "Player 1: "
    meow score1
    purr "Player 2: "
    meow score2