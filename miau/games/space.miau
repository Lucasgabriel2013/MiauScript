#copycat "screen/paint.miau"
#copycat "screen/physics.miau"
#copycat "util/math.miau"
#copycat "util/arrays.miau"

__init:
    global playerX = 48.0
    const playerY = 44
    const playerW = 6
    const playerH = 3

    global laserActive = 0
    global laserX = 0.0
    global laserY = 0.0

    global astX = 20.0
    global astY = 0.0
    global astSpeed = 0.1
    global astSpeed = 0.1
    global astSize = 10.0

    global shakeTimer = 0
    global offsetX = 0.0
    global offsetY = 0.0

    arrayCreate() : eList
    global expList = eList

    arrayCreate() : sList
    global starList = sList

    var i = 1
    while (i <= 8) do:
        object star
        var pseudo = i * 17
        var star["x"] = pseudo % 95

        var j = i * 10
        var star["y"] = j % 50

        var j = i % 3
        var star["speed"] = 0.2 + j * 0.15
        arrayAdd(starList, star)
        var i = i + 1
    done

    global score = 0
    global lives = 3
    global playing = 1
    global tick = 0
    return

lerInput():
    keyboard "A"
    keyboard "D"
    keyboard "SPACE"
    keyboard "W"

    if (A) then:
        mathClamp(playerX - 1.0, 0, 94) : res
        if (W) then: mathClamp(playerX - 2.5, 0, 94) : res
        global playerX = res
    end

    if (D) then:
        mathClamp(playerX + 1.0, 0, 94) : res
        if (W) then: mathClamp(playerX + 2.5, 0, 94) : res
        global playerX = res
    end

    if (SPACE & laserActive == 0) then:
        global laserActive = 1
        global laserX = playerX + 2.5
        global laserY = 42.0
    end
    return

atualizarEstrelas():
    var i = 1
    var len = starList["length"]

    while (i <= len) do:
        var star = starList[i]
        var star["y"] = star["y"] + star["speed"]

        if (star["y"] >= 50.0) then:
            var star["y"] = 0.0
            var pseudoRand = tick * i * 13
            var star["x"] = pseudoRand % 95
        end
        var i = i + 1
    done
    return

atualizarLaser():
    if (laserActive) then:
        global laserY = laserY - astSpeed * 3
        if (laserY < 0) then: global laserActive = 0
    end
    return

atualizarInimigo():
    global astY = astY + astSpeed

    if (astY >= 45) then:
        global lives = lives - 1
        global shakeTimer = 10
        resetInimigo()

        if (lives == 0) then: global playing = 0
    end
    return

atualizarParticulas():
    var i = 1
    var len = expList["length"]
    var ativas = 0

    while (i <= len) do:
        var part = expList[i]
        if (part["life"] > 0) then:
            var part["x"] = part["x"] + part["dx"]
            var part["y"] = part["y"] + part["dy"]
            var part["life"] = part["life"] - 1
            var ativas = ativas + 1
        end
        var i = i + 1
    done

    if (ativas == 0) then: arrayClear(expList)
    return

atualizarShake():
    if (shakeTimer > 0) then:
        global shakeTimer = shakeTimer - 1

        var alternador = tick % 3
        if (alternador == 0) then:
            global offsetX = 1.5
            global offsetY = -1.5
        end
        if (alternador == 1) then:
            global offsetX = -1.5
            global offsetY = 1.5
        end
        if (alternador == 2) then:
            global offsetX = 0.5
            global offsetY = -0.5
        end
    end
    if (shakeTimer == 0) then:
        global offsetX = 0.0
        global offsetY = 0.0
    end
    return

verificarColisoes():
    if (laserActive) then:
        checkCollision(laserX, laserY, 1, 2, astX, astY, astSize, astSize) : collidedLaser
        if (collidedLaser) then:
            if (astSize < 8.0) then: global score = score + 25
            if (astSize >= 8.0) then: global score = score + 10

            global laserActive = 0
            var halfSize = astSize / 2.0
            dispararExplosao(astX + halfSize, astY + halfSize)
            resetInimigo()
        end
    end

    checkCollision(playerX, playerY, playerW, playerH, astX, astY, astSize, astSize) : collidedPlayer
    if (collidedPlayer) then:
        global lives = lives - 1
        global shakeTimer = 15
        dispararExplosao(playerX + 3.0, playerY + 1.0)
        resetInimigo()

        if (lives == 0) then: global playing = 0
    end
    return

dispararExplosao(x, y):
    arrayClear(expList)

    adicionarParticulaLista(x, y, -0.8, -0.5)
    adicionarParticulaLista(x, y, 0.8, -0.8)
    adicionarParticulaLista(x, y, -0.4, 0.6)
    adicionarParticulaLista(x, y, 0.6, 0.4)
    adicionarParticulaLista(x, y, 0.0, -1.0)
    adicionarParticulaLista(x, y, 0.0, 1.0)
    adicionarParticulaLista(x, y, -1.0, 0.0)
    adicionarParticulaLista(x, y, 1.0, 0.0)
    return

adicionarParticulaLista(px, py, pdx, pdy):
    object p
    var p["x"] = px
    var p["y"] = py
    var p["dx"] = pdx
    var p["dy"] = pdy
    var p["life"] = 12
    arrayAdd(expList, p)
    return

resetInimigo():
    var pseudoRand = tick * 31
    var rawX = pseudoRand % 75
    var nextX = rawX + 5

    global astX = nextX
    global astY = 0.0

    var sizeRoll = pseudoRand % 3
    if (sizeRoll == 0) then:
        global astSize = 6.0
        var speedBase = 0.5
    end
    if (sizeRoll == 1) then:
        global astSize = 10.0
        var speedBase = 0.25
    end
    if (sizeRoll == 2) then:
        global astSize = 14.0
        var speedBase = 0.1
    end

    var speedIncr = score / 400
    global astSpeed = speedBase + speedIncr
    return

desenharJogo():
    paintAll(0, 0, 0)

    var i = 1
    while (i <= starList["length"]) do:
        var star = starList[i]
        paintPixel(star["x"] + offsetX, star["y"] + offsetY, 150, 150, 180)
        var i = i + 1
    done

    var k = 1
    while (k <= expList["length"]) do:
        var part = expList[k]
        if (part["life"] > 0) then:
            var gExp = part["life"] * 20
            paintPixel(part["x"] + offsetX, part["y"] + offsetY, 255, gExp, 0)
        end
        var k = k + 1
    done

    var sPlayerX = playerX + offsetX
    var sPlayerY = playerY + offsetY
    paintRect(sPlayerX, sPlayerY, playerW, playerH, 30, 180, 30)

    var wingL = sPlayerX - 1.0
    var wingR = sPlayerX + 6.0
    var wingY = sPlayerY + 2.0
    if (wingL >= 0.0 & wingL < 100.0 & wingY >= 0.0 & wingY < 50.0) then: paintPixel(wingL, wingY, 150, 255, 150)
    if (wingR >= 0.0 & wingR < 100.0 & wingY >= 0.0 & wingY < 50.0) then: paintPixel(wingR, wingY, 150, 255, 150)

    var cabinX = sPlayerX + 2.0
    var cabinY = sPlayerY - 1.0
    paintOval(cabinX, cabinY, 2, 2, 50, 240, 255)

    var sAstX = astX + offsetX
    var sAstY = astY + offsetY

    if (sAstY > 2.0) then:
        var halfAst = astSize / 2.0
        var fireW = astSize * 0.25
        if (fireW < 1.0) then: var fireW = 1.0
        var fireH = astSize * 0.3
        if (fireH < 2.0) then: var fireH = 2.0

        var fLeftX = sAstX + halfAst - fireW
        var fRightX = sAstX + halfAst
        var fCenterY = sAstY - fireH

        var spark = tick % 2
        if (spark == 0) then:
            paintRect(fLeftX, fCenterY, fireW, fireH, 255, 69, 0)
            paintRect(fRightX, fCenterY, fireW, fireH, 255, 140, 0)
            paintRect(sAstX + halfAst - 0.5, fCenterY - 1.0, 1, 1, 255, 0, 0)
        end
        if (spark == 1) then:
            paintRect(fLeftX, fCenterY, fireW, fireH, 255, 140, 0)
            paintRect(fRightX, fCenterY, fireW, fireH, 255, 69, 0)
            paintRect(sAstX + halfAst - 0.5, fCenterY - 1.0, 1, 1, 255, 120, 0)
        end
    end

    paintOval(sAstX, sAstY, astSize, astSize, 130, 100, 80)

    var offsetCrater = astSize / 5.0
    var craterDim = astSize / 8.0
    if (craterDim < 1.0) then: var craterDim = 1.0
    if (craterDim > 2.0) then: var craterDim = 2.0

    var crat1X = sAstX + offsetCrater
    var crat1Y = sAstY + offsetCrater * 1.5
    var crat2X = sAstX + offsetCrater * 3.5
    var crat2Y = sAstY + offsetCrater * 2.0
    var crat3X = sAstX + offsetCrater * 2.0
    var crat3Y = sAstY + offsetCrater * 3.5

    paintRect(crat1X, crat1Y, craterDim, craterDim, 70, 50, 40)
    paintRect(crat2X, crat2Y, craterDim, craterDim, 70, 50, 40)
    paintRect(crat3X, crat3Y, craterDim, craterDim, 70, 50, 40)

    if (laserActive) then: paintRect(laserX + offsetX, laserY + offsetY, 1, 2, 50, 255, 255)

    if (lives >= 1) then:
        paintRect(2, 2, 3, 2, 50, 255, 50)
        paintPixel(3, 1, 100, 255, 100)
    end
    if (lives >= 2) then:
        paintRect(7, 2, 3, 2, 50, 255, 50)
        paintPixel(8, 1, 100, 255, 100)
    end
    if (lives >= 3) then:
        paintRect(12, 2, 3, 2, 50, 255, 50)
        paintPixel(13, 1, 100, 255, 100)
    end

    repaint
    return

main():
    meow "--- INICIANDO MIAU INVADERS ---"

    while (playing) do:
        global tick = tick + 1

        lerInput()
        atualizarEstrelas()
        atualizarLaser()
        atualizarInimigo()
        atualizarParticulas()
        atualizarShake()
        verificarColisoes()
        desenharJogo()

        sleep 16
    done

    paintAll(0, 0, 0)
    repaint
    meow "GAME OVER!"
    purr "Pontuacao Final: "
    meow score