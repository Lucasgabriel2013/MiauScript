__init:
    const WIDTH = 100
    const HEIGHT = 50
    return

paintPixel(x, y, r, g, b):
    if (x > -1 & x < 100 & y > -1 & y < 50) then:
        setPixel (x, y, r, g, b)
        return
    end

    error ("Tentativa de PaintPixe fora da tela")

paintRect(x, y, rw, rh, r, g, b):
    var dx = 0
    while (dx < rw) do:
        var dy = 0
        while (dy < rh) do:
            call paintPixel(x + dx, y + dy, r, g, b)
            var dy = dy + 1
        done
        var dx = dx + 1
    done
    return

paintAll(r, g, b):
    call paintRect(0, 0, WIDTH, HEIGHT, r, g, b)
    return

paintPointPixel(point, r, g, b):
    var px = point % 100
    var tempY = point - px
    var py = tempY / 100

    call paintPixel(px, py, r, g, b)
    return

paintPointRect(point, w, h, r, g, b):
    var px = point % 100
    var tempY = point - px
    var py = tempY / 100

    call paintRect(px, py, w, h, r, g, b)
    return