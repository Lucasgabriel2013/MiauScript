__init:
    const WIDTH = 100
    const HEIGHT = 50
    return

paintPixel(x, y, r, g, b):
    if (x > -1 & x < 100 & y > -1 & y < 50) then:
        setPixel x, y, r, g, b
    end

    return

paintRect(x, y, rw, rh, r, g, b):
    var dx = 0
    while (dx < rw) do:
        var dy = 0
        while (dy < rh) do:
            paintPixel(x + dx, y + dy, r, g, b)
            var dy = dy + 1
        done
        var dx = dx + 1
    done
    return

paintOval(x, y, w, h, r, g, b):
    var rx = w / 2.0
    var ry = h / 2.0

    var cx = x + rx
    var cy = y + ry

    var py = y
    var limitY = y + h
    while (py < limitY) do:
        var px = x
        var limitX = x + w
        while (px < limitX) do:

            if (px >= 0.0 & px < 100.0 & py >= 0.0 & py < 50.0) then:
                var pixelCenterX = px + 0.5
                var pixelCenterY = py + 0.5

                var dx = pixelCenterX - cx
                var dy = pixelCenterY - cy

                var dxSq = dx * dx
                var rxSq = rx * rx
                var termX = dxSq / rxSq

                var dySq = dy * dy
                var rySq = ry * ry
                var termY = dySq / rySq

                var ellipseValue = termX + termY

                if (ellipseValue <= 1.0) then:
                    paintPixel(px, py, r, g, b)
                end
            end

            var px = px + 1.0
        done

        var py = py + 1.0
    done
    return

paintAll(r, g, b):
    paintRect(0, 0, WIDTH, HEIGHT, r, g, b)
    return