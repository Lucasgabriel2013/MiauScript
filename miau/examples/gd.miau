#copycat "screen/paint.miau"

__init:
    :/ Posição e física do jogador (Cubo)
    global px = 15.0
    global py = 35.0
    global velY = 0.0
    global gravidade = 1.6
    global forcaPulo = -6.5
    global noChao = 1.0

    :/ Posição do obstáculo (Obstáculo em Bloco)
    global ox = 90.0
    global oy = 35.0
    global velObstaculo = 3.5

    :/ Estado do Jogo
    global score = 0.0
    global jogando = 1.0
    return

main():
    meow ("--- MIAU DASH STARTED ---")
    meow ("Aperte W ou ESPAÇO para Pular!")

    while (jogando) do:
        call atualizarFisica()
        call atualizarObstaculo()
        call checarColisao()
        call renderizar()

        sleep 30
    done

    meow ("--- GAME OVER ---")
    meow ("Sua pontuacao final:")
    meow (score)

    sleep 2000
    exit

atualizarFisica():
    keyboard w
    keyboard space

    var querPular = w | space

    if (querPular == 1.0) then:
        if (noChao == 1.0) then:
            global velY = forcaPulo
            global noChao = 0.0
        end
    end

    if (noChao == 0.0) then:
        global velY = velY + gravidade
        global py = py + velY
    end

    if (py >= 35.0) then:
        global py = 35.0
        global velY = 0.0
        global noChao = 1.0
    end
    return

atualizarObstaculo():
    global ox = ox - velObstaculo

    if (ox < 2.0) then:
        global ox = 90.0
        global score = score + 1.0

        var restoScore = score % 3
        if (restoScore == 0.0) then:
            global velObstaculo = velObstaculo + 0.5
        end
    end
    return

checarColisao():
    var diffX = px - ox

    if (diffX < 0.0) then:
        var diffX = 0.0 - diffX
    end

    if (diffX < 5.0) then:
        if (py > 31.0) then:
            global jogando = 0.0
        end
    end
    return

renderizar():
    :/ 1. Desenha o Fundo (Céu e Chão) em apenas duas grandes chamadas
    call setColors(20, 150, 220)
    call paintRect(0, 0, 100, 40)

    call setColors(30, 20, 50)
    call paintRect(0, 40, 100, 9)

    :/ Trunca posições do jogador
    var restX = px % 1
    var rx = px - restX
    var restY = py % 1
    var ry = py - restY

    :/ 2. Desenha o jogador (Apenas 1 chamada)
    call setColors(50, 255, 50)
    call paintRect(rx, ry, 5, 5)

    :/ Trunca posições do obstáculo
    var restOX = ox % 1
    var rox = ox - restOX
    var restOY = oy % 1
    var roy = oy - restOY

    :/ 3. Desenha o obstáculo como um bloco quadrado (Apenas 1 chamada rápida!)
    if (rox < 93.0) then:
        if (rox > 2.0) then:
            call setColors(255, 50, 50)
            call paintRect(rox, roy, 5, 5)
        end
    end
    return