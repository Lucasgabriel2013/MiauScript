__init:
    global LARGURA = 100
    global ALTURA = 50
    return

main():
    call print("--- INICIANDO RENDERIZADOR DE PLASMA TELA CHEIA ---")
    call clearConsole()

    var rodando = 1
    var tempo = 0

    :/ Loop Principal da Animação
    while (rodando) do:

        var y = 0
        while (y < ALTURA) do:
            var x = 0
            while (x < LARGURA) do:

                :/ Equações de onda baseadas no tempo e posição (usando o operador % com espaços)
                var ondaX = x + tempo
                var modX = ondaX % 16

                var ondaY = y + tempo
                var modY = ondaY % 16

                :/ Combinação das ondas para gerar o padrão de plasma (efeito XOR/Grid)
                var combinacao = modX + modY
                var corSinal = combinacao % 3

                :/ Mapeia os sinais matemáticos em 3 paletas de cores dinâmicas que cobrem a tela
                if (corSinal == 0) then:
                    :/ Tons de Azul e Ciano Elétrico
                    var r = 0
                    var g = x * 2
                    var b = 255
                    setPixel (x, y, r, g, b)
                end

                if (corSinal == 1) then:
                    :/ Tons de Roxo e Magnitude
                    var r = y * 4
                    var g = 0
                    var b = 200
                    setPixel (x, y, r, g, b)
                end

                if (corSinal == 2) then:
                    :/ Tons de Verde Neon e Transições
                    var r = 0
                    var g = 255
                    var b = x + y
                    setPixel (x, y, r, g, b)
                end

                var x = x + 1
            done
            var y = y + 1
        done

        :/ Avança o tempo para fazer o plasma se mover organicamente pela tela
        var tempo = tempo + 1

        var limiteTempo = tempo > 100
        if (limiteTempo == 1) then:
            var tempo = 0
        end

        call logPlasma(tempo)
        sleep 10
    done

print(msg):
    meow (msg)
    return

clearConsole():
    clear
    return

logPlasma(t):
    purr ("Plasma Engine Ativa -> Tempo: ")
    meow (t)
    return