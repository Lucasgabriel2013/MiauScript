#copycat "screen/paint.miau"

main():
    call setColors(0, 0, 0)
    :/ Inicializa limpando a tela
    call paintAll()

    var rodando = 1
    var loopChao = 0
    var frameMario = 0
    var nuvemX = 80

    :/ --- LOOP PRINCIPAL DA ANIMAÇÃO ---
    while (rodando) do:

        :/ 1. DESENHA O CÉU
        call setColors(92, 148, 252)
        call paintRect(0, 0, 100, 40)

        :/ 2. DESENHA AS NUVENS (Seguro contra indices negativos)
        var nx = nuvemX
        if (nx > 0) then:
            if (nx < 85) then:
                :/ Se a nuvem está totalmente dentro da tela, usa o Rect rápido
                call setColors(255, 255, 255)
                call paintRect(nx, 10, 15, 5)
            end
        end

        :/ Tratamento de borda: desenha pixel por pixel apenas quando estiver saindo
        if (nx < 1) then:
            var cx = 0
            while (cx < 15) do:
                var nPixelX = nx + cx
                if (nPixelX > 0) then:
                    call setColors(255, 255, 255)
                    call paintPixel(nPixelX, 10)
                    call paintPixel(nPixelX, 11)
                    call paintPixel(nPixelX, 12)
                    call paintPixel(nPixelX, 13)
                    call paintPixel(nPixelX, 14)
                end
                var cx = cx + 1
            done
        end

        var nuvemX = nuvemX - 1
        if (nuvemX < -15) then:
            var nuvemX = 100
        end

        :/ 3. DESENHA O CHÃO DE TIJOLOS
        var yChao = 40
        while (yChao < 50) do:
            var xChao = 0
            while (xChao < 100) do:
                var xDeslocado = xChao + loopChao
                var padrao = xDeslocado % 10

                if (padrao < 8) then:
                    call setColors(200, 76, 12)
                    call paintPixel(xChao, yChao)
                end
                if (padrao > 7) then:
                    call setColors(0, 0, 0)
                    call paintPixel(xChao, yChao)
                end
                var xChao = xChao + 1
            done
            var yChao = yChao + 1
        done

        var loopChao = loopChao + 2
        if (loopChao > 40) then:
            var loopChao = 0
        end


        :/ 4. RENDERIZA O MARIO NES (PROPORÇÃO EXATA OTIMIZADA COM RECT)
        var mx = 44

        :/ Linha 24: Topo do Boné (Vermelho)
        call setColors(228, 0, 0)
        call paintRect(mx + 3, 24, 5, 1)

        :/ Linha 25: Aba do Boné (Vermelho)
        call paintRect(mx + 2, 25, 8, 1)

        :/ Linha 26: Cabelo e Rosto
        call setColors(105, 50, 0)
        call paintRect(mx + 2, 26, 3, 1)
        call setColors(252, 196, 132)
        call paintRect(mx + 5, 26, 2, 1)
        call setColors(0, 0, 0)
        call paintPixel(mx + 7, 26)
        call setColors(252, 196, 132)
        call paintPixel(mx + 8, 26)

        :/ Linha 27: Orelha e Olho
        call setColors(105, 50, 0)
        call paintPixel(mx + 1, 27)
        call setColors(252, 196, 132)
        call paintPixel(mx + 2, 27)
        call setColors(105, 50, 0)
        call paintPixel(mx + 3, 27)
        call setColors(252, 196, 132)
        call paintRect(mx + 4, 27, 3, 1)
        call setColors(0, 0, 0)
        call paintPixel(mx + 7, 27)
        call setColors(252, 196, 132)
        call paintRect(mx + 8, 27, 3, 1)

        :/ Linha 28: Bigode e Nariz
        call setColors(105, 50, 0)
        call paintPixel(mx + 1, 28)
        call setColors(252, 196, 132)
        call paintPixel(mx + 2, 28)
        call setColors(105, 50, 0)
        call paintRect(mx + 3, 28, 2, 1)
        call setColors(252, 196, 132)
        call paintRect(mx + 5, 28, 3, 1)
        call setColors(105, 50, 0)
        call paintRect(mx + 8, 28, 4, 1)

        :/ Linha 29: Queixo e Boca
        call setColors(252, 196, 132)
        call paintRect(mx + 2, 29, 8, 1)

        :/ Linha 30: Ombro e Camisa (Vermelho e Azul)
        call setColors(228, 0, 0)
        call paintRect(mx + 2, 30, 2, 1)
        call setColors(0, 0, 180)
        call paintPixel(mx + 4, 30)
        call setColors(228, 0, 0)
        call paintRect(mx + 5, 30, 2, 1)
        call setColors(0, 0, 180)
        call paintPixel(mx + 7, 30)
        call setColors(228, 0, 0)
        call paintPixel(mx + 8, 30)

        :/ Linha 31: Peito e Macacão
        call setColors(228, 0, 0)
        call paintRect(mx + 1, 31, 3, 1)
        call setColors(0, 0, 180)
        call paintPixel(mx + 4, 31)
        call setColors(228, 0, 0)
        call paintRect(mx + 5, 31, 2, 1)
        call setColors(0, 0, 180)
        call paintRect(mx + 7, 31, 2, 1)
        call setColors(228, 0, 0)
        call paintPixel(mx + 9, 31)

        :/ Linha 32: Mangas e Botões Amarelos
        call setColors(228, 0, 0)
        call paintRect(mx + 1, 32, 2, 1)
        call setColors(0, 0, 180)
        call paintPixel(mx + 3, 32)
        call setColors(255, 255, 0)
        call paintPixel(mx + 4, 32)
        call setColors(0, 0, 180)
        call paintRect(mx + 5, 32, 2, 1)
        call setColors(255, 255, 0)
        call paintPixel(mx + 7, 32)
        call setColors(0, 0, 180)
        call paintPixel(mx + 8, 32)
        call setColors(228, 0, 0)
        call paintPixel(mx + 9, 32)

        :/ Linha 33: Cintura e Mãos
        call setColors(252, 196, 132)
        call paintRect(mx, 33, 2, 1)
        call setColors(0, 0, 180)
        call paintRect(mx + 2, 33, 7, 1)
        call setColors(252, 196, 132)
        call paintRect(mx + 9, 33, 2, 1)

        :/ Linha 34: Base do Macacão
        call setColors(0, 0, 180)
        call paintRect(mx + 2, 34, 7, 1)

        :/ Linha 35: Coxas
        call paintRect(mx + 2, 35, 3, 1)
        call paintRect(mx + 6, 35, 3, 1)


        :/ --- ANIMAÇÃO RIGOROSA DAS PERNAS ---
        var modFrame = frameMario % 2

        if (modFrame == 0) then:
            call setColors(0, 0, 180)
            call paintRect(mx + 2, 36, 2, 1)
            call paintRect(mx + 7, 36, 2, 1)

            call setColors(105, 50, 0)
            call paintRect(mx + 1, 37, 2, 1)
            call setColors(0, 0, 180)
            call paintRect(mx + 7, 37, 2, 1)

            call setColors(105, 50, 0)
            call paintRect(mx + 7, 38, 3, 1)
        end

        if (modFrame == 1) then:
            call setColors(0, 0, 180)
            call paintRect(mx + 3, 36, 2, 1)
            call paintPixel(mx + 7, 36)

            call paintRect(mx + 3, 37, 2, 1)
            call setColors(105, 50, 0)
            call paintRect(mx + 7, 38, 2, 1)

            call paintRect(mx + 2, 38, 3, 1)
        end

        var frameMario = frameMario + 1

        purr ("Super Mario Engine Ativa -> Frame: ")
        meow (frameMario)

        sleep 60
    done