#copycat "screen/paint.miau"
#copycat "screen/collision.miau"
#copycat "screen/point.miau"
#copycat "util/arrays.miau"

__init:
    global dirX = 1
    global dirY = 0

    call arrayCreate() : sb
    global snakeBody = sb

    call arrayAdd(snakeBody, 2450.0)
    call arrayAdd(snakeBody, 2448.0)
    call arrayAdd(snakeBody, 2446.0)

    global foodX = 0.0
    global foodY = 0.0
    call spawnFood()

    global alive = 1.0
    global score = 0.0
    return

spawnFood():
    random rx = 44
    random ry = 19
    var fx = rx * 2
    global foodX = fx + 4
    var fy = ry * 2
    global foodY = fy + 4
    return

main():
    while (alive) do:
        call lerControles()
        call atualizarCobra()
        call verificarColisoes()

        if (alive) then: call desenharTela()
        sleep 16
    done

    call paintAll(255, 0, 0)
    repaint
    meow ("Game Over! Score: " + score)

    sleep 2000
    exit

lerControles():
    keyboard "W"
    keyboard "A"
    keyboard "S"
    keyboard "D"

    if (W == 1 & dirY != 1) then:
        global dirX = 0
        global dirY = -1
    end
    if (S == 1 & dirY != -1) then:
        global dirX = 0
        global dirY = 1
    end
    if (A == 1 & dirX != 1) then:
        global dirX = -1
        global dirY = 0
    end
    if (D == 1 & dirX != -1) then:
        global dirX = 1
        global dirY = 0
    end
    return

atualizarCobra():
    call arrayShiftRight(snakeBody)

    var headKey = snakeBody[1]
    call getX(headKey) : hX
    call getY(headKey) : hY

    var stepX = dirX * 2
    var nextX = hX + stepX
    var stepY = dirY * 2
    var nextY = hY + stepY

    call pointCreate(nextX, nextY) : nextKey
    var snakeBody[1] = nextKey
    return

verificarColisoes():
    var headKey = snakeBody[1]
    call getX(headKey) : hX
    call getY(headKey) : hY

    if (hX < 0 | hX > 98 | hY < 0 | hY > 48) then: global alive = 0.0

    var i = 3
    var len = snakeBody["length"]
    while (i <= len) do:
        var corpoKey = snakeBody[i]
        if (headKey == corpoKey) then:
            global alive = 0.0
        end
        var i = i + 1
    done

    call checkCollision(hX, hY, 2, 2, foodX, foodY, 2, 2) : colidiu

    if (colidiu) then:
        global score = score + 10

        var cauda = snakeBody["length"]
        var lastKey = snakeBody[cauda]
        call arrayAdd(snakeBody, lastKey)

        call spawnFood()
    end
    return

desenharTela():
    call paintAll(0, 0, 0)

    call paintRect(foodX, foodY, 2, 2, 255, 0, 0)

    var i = 1
    var len = snakeBody["length"]
    while (i <= len) do:
        var key = snakeBody[i]
        call paintPointRect(key, 2, 2, 0, 255, 0)
        var i = i + 1
    done

    repaint
    return