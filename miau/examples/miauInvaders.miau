#copycat "screen/paint.miau"

__init:
    :/ Posição do jogador (Nave) - Começa no centro inferior
    global playerX = 50
    global playerY = 45

    :/ Estado do Tiro do Jogador (0 = Inativo, 1 = Na tela)
    global tiroAtivo = 0
    global tiroX = 0
    global tiroY = 0

    :/ Posições dos Invasores (3 Invasores)
    global inv1X = 20
    global inv1Y = 10
    global inv1Vivo = 1

    global inv2X = 50
    global inv2Y = 12
    global inv2Vivo = 1

    global inv3X = 80
    global inv3Y = 8
    global inv3Vivo = 1

    :/ Direção de movimento dos invasores (1 = Direita, -1 = Esquerda)
    global invDir = 1
    global invSpeedTimer = 0

    :/ Estado do jogo
    global score = 0
    global jogando = 1
    return

main():
    meow ("--- MIAU INVADERS ---")
    meow ("Controles: A e D movem, SPACE atira!")

    while (jogando) do:
        call lerControles()
        call atualizarJogo()
        call desenharCenario()

        :/ Verifica condição de vitória (todos os invasores mortos)
        if (inv1Vivo == 0 & inv2Vivo == 0 & inv3Vivo == 0) then:
            global jogando = 0
            meow ("VOCE SALVOU O PLANETA DOS MIAUS!")
        end

        sleep 50
    done

    meow ("FIM DE JOGO!")
    purr ("Pontuacao Final: ")
    meow (score)
    exit

lerControles():
    keyboard a
    keyboard d
    keyboard space

    :/ Mover jogador para a esquerda
    if (a & playerX > 2) then:
        global playerX = playerX - 2
    end

    :/ Mover jogador para a direita
    if (d & playerX < 96) then:
        global playerX = playerX + 2
    end

    :/ Atirar (Só permite um tiro por vez na tela)
    if (space & tiroAtivo == 0) then:
        global tiroAtivo = 1
        global tiroX = playerX + 1
        global tiroY = playerY - 1
    end
    return

atualizarJogo():
    :/ 1. Atualizar movimento do tiro
    if (tiroAtivo) then:
        global tiroY = tiroY - 2

        :/ Se o tiro sumir no topo da tela
        if (tiroY < 0) then:
            global tiroAtivo = 0
        end
    end

    :/ 2. Atualizar movimento dos Invasores (Mais lento que o jogador)
    global invSpeedTimer = invSpeedTimer + 1
    if (invSpeedTimer == 3) then:
        global invSpeedTimer = 0

        :/ Move horizontalmente todos os invasores vivos
        global inv1X = inv1X + invDir
        global inv2X = inv2X + invDir
        global inv3X = inv3X + invDir

        :/ Se algum invasor bater nas bordas laterais, inverte a direção e desce todos eles
        if (inv1X > 95 | inv2X > 95 | inv3X > 95 | inv1X < 2 | inv2X < 2 | inv3X < 2) then:
            global invDir = 0 - invDir
            global inv1Y = inv1Y + 1
            global inv2Y = inv2Y + 1
            global inv3Y = inv3Y + 1
        end
    end

    :/ 3. Checar colisão do Tiro com os Invasores
    if (tiroAtivo) then:
        :/ Testar Invasor 1
        if (inv1Vivo & tiroX > inv1X - 1 & tiroX < inv1X + 4 & tiroY == inv1Y) then:
            global inv1Vivo = 0
            global tiroAtivo = 0
            global score = score + 100
        end

        :/ Testar Invasor 2
        if (inv2Vivo & tiroX > inv2X - 1 & tiroX < inv2X + 4 & tiroY == inv2Y) then:
            global inv2Vivo = 0
            global tiroAtivo = 0
            global score = score + 100
        end

        :/ Testar Invasor 3
        if (inv3Vivo & tiroX > inv3X - 1 & tiroX < inv3X + 4 & tiroY == inv3Y) then:
            global inv3Vivo = 0
            global tiroAtivo = 0
            global score = score + 100
        end
    end

    :/ 4. Condição de derrota: Se algum invasor chegar muito perto do chão
        if (inv1Vivo & inv1Y > 42) then:
            global jogando = 0
        end
        if (inv2Vivo & inv2Y > 42) then:
            global jogando = 0
        end
        if (inv3Vivo & inv3Y > 42) then:
            global jogando = 0
        end
    return

desenharCenario():
    :/ Limpa a tela com preto (Usando a sua biblioteca carregada)
    call setColors(0, 0, 0)
    call paintAll()

    :/ Desenha o Jogador (Uma navezinha verde usando paintRect)
    call setColors(0, 255, 0)
    call paintRect(playerX, playerY, 3, 2)

    :/ Desenha o Tiro se ele estiver ativo (Pixel Azul)
    if (tiroAtivo) then:
        call setColors(0, 150, 255)
        call paintPixel(tiroX, tiroY)
    end

    :/ Desenha os Invasores vivos (Retângulos Vermelhos)
    call setColors(255, 50, 50)

    if (inv1Vivo) then:
        call paintRect(inv1X, inv1Y, 4, 2)
    end
    if (inv2Vivo) then:
        call paintRect(inv2X, inv2Y, 4, 2)
    end
    if (inv3Vivo) then:
        call paintRect(inv3X, inv3Y, 4, 2)
    end
    return