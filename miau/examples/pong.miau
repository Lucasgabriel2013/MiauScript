#copycat "screen/paint.miau"
#copycat "screen/collision.miau"
#copycat "util/math.miau"

__init:
    global p1Y = 20.0
    global p2Y = 20.0
    global ballX = 50.0
    global ballY = 24.0
    global ballVX = 1.5
    global ballVY = 1.0
    global score1 = 0
    global score2 = 0
    global playing = 1
    return

main():
    meow ("--- INICIANDO MIAU PONG ---")
    while (playing) do:
        call lerControles()
        call moverIA()

        :/ Física & Movimento da Bola
        global ballX = ballX + ballVX
        global ballY = ballY + ballVY

        call verificarColisoes()
        call desenharTela()
        sleep 16
    done

    call paintAll(0, 0, 0)
    repaint
    meow ("GAME OVER!")
    purr ("Player 1: ")
    meow (score1)
    purr ("Player 2: ")
    meow (score2)

    sleep 2000
    exit

lerControles():
    keyboard "W"
    keyboard "S"

    if (W) then:
        call mathClamp(p1Y - 1.5, 0, 40) : res
        global p1Y = res
    end

    if (S) then:
        call mathClamp(p1Y + 1.5, 0, 40) : res
        global p1Y = res
    end
    return

moverIA():
    :/ Persegue a bola suavemente aplicando a lógica do mathClamp
    var dir = 0.0
    var targetY = ballY - 4

    if (p2Y < targetY) then: var dir = 1.0
    if (p2Y > targetY) then: var dir = -1.0

    call mathClamp(p2Y + dir, 0, 40) : res
    global p2Y = res
    return

verificarColisoes():
    :/ Teto / Chão
    if (ballY <= 0 | ballY >= 48) then:
        call mathClamp(ballY, 0, 48) : res
        global ballY = res
        global ballVY = ballVY * -1
    end

    :/ Colisão Raquete Esquerda (P1)
    call checkCollision(ballX, ballY, 2, 2, 4, p1Y, 2, 10)
    if (result == 1) then:
        global ballX = 6.0
        global ballVX = ballVX * -1
        global ballVY = ballVY + 0.2
    end

    :/ Colisão Raquete Direita (P2)
    call checkCollision(ballX, ballY, 2, 2, 94, p2Y, 2, 10)
    if (result == 1) then:
        global ballX = 92.0
        global ballVX = ballVX * -1
        global ballVY = ballVY - 0.2
    end

    :/ Pontuação e Reset
    if (ballX < 0 | ballX > 98) then:
        if (ballX < 0) then: global score2 = score2 + 1
        if (ballX > 98) then: global score1 = score1 + 1

        global ballX = 50.0
        global ballY = 24.0
        global ballVX = ballVX * -1
    end

    if (score1 == 5 | score2 == 5) then: global playing = 0
    return

desenharTela():
    call paintAll(0, 0, 0)
    call paintRect(49, 0, 2, 50, 100, 100, 100)
    call paintRect(4, p1Y, 2, 10, 50, 150, 255)
    call paintRect(94, p2Y, 2, 10, 255, 50, 50)
    call paintRect(ballX, ballY, 2, 2, 255, 255, 255)
    repaint
    return