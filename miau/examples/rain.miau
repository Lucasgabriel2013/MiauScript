__init:
    global LARGURA = 100
    global ALTURA = 50
    const COR_FUNDO = 0
    return

main():
    call print("--- INICIANDO MIAUSCRIPT ENGINE ---")
    call print("Configurando cenario...")

    var rodando = 1
    var frames = 0

    :/ Cria um objeto para guardar o estado das gotas
    object gotasX
    object gotasY

    var gotasX[0] = 10
    var gotasY[0] = 0
    var gotasX[1] = 45
    var gotasY[1] = 15
    var gotasX[2] = 80
    var gotasY[2] = 30

    call clearConsole()

    while (rodando) do:
        :/ 1. Limpa a tela redesenhando o fundo escuro
        var x = 0
        while (x < LARGURA) do:
            var y = 0
            while (y < ALTURA) do:
                setPixel (x, y, COR_FUNDO, COR_FUNDO, 20)
                var y = y + 1
            done
            var x = x + 1
        done

        :/ 2. Desenha e atualiza a Gota 0
        var gx = gotasX[0]
        var gy = gotasY[0]
        setPixel (gx, gy, 0, 255, 100)
        var gy = gy + 2
        if (gy > 49) then:
            var gy = 0
            random novaX = 100
            var gotasX[0] = novaX
        end
        var gotasY[0] = gy

        :/ 3. Desenha e atualiza a Gota 1
        var gx = gotasX[1]
        var gy = gotasY[1]
        setPixel (gx, gy, 0, 200, 255)
        var gy = gy + 3
        if (gy > 49) then:
            var gy = 0
            random novaX = 100
            var gotasX[1] = novaX
        end
        var gotasY[1] = gy

        :/ 4. Desenha e atualiza a Gota 2
        var gx = gotasX[2]
        var gy = gotasY[2]
        setPixel (gx, gy, 255, 0, 255)
        var gy = gy + 1
        if (gy > 49) then:
            var gy = 0
            random novaX = 100
            var gotasX[2] = novaX
        end
        var gotasY[2] = gy

        :/ Logs de telemetria no console usando purr e meow
        var frames = frames + 1
        call logFrame(frames)

        :/ Controla o framerate da animacao (30ms de espera)
        sleep 30
    done

print(msg):
    meow (msg)
    return

clearConsole():
    clear
    return

logFrame(f):
    purr ("Renderizado Frame: ")
    meow (f)
    return