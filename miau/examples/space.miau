#copycat "screen/paint.miau"
#copycat "screen/collision.miau"
#copycat "util/math.miau"

__init:
    :/ Posição do Jogador (Nave) na parte inferior da tela
    global playerX = 48.0
    const playerY = 44
    const playerW = 6
    const playerH = 3

    :/ Estado do Laser (Tiro)
    global laserActive = 0
    global laserX = 0.0
    global laserY = 0.0

    :/ Estado do Asteroide (Inimigo)
    global astX = 20.0
    global astY = 0.0
    global astSpeed = 0.5

    :/ Estado do Jogo
    global score = 0
    global lives = 3
    global playing = 1
    global tick = 0
    return

main():
    meow ("--- INICIANDO MIAU INVADERS ---")

    while (playing == 1) do:
        :/ Incrementa o contador de frames para usar como seed aleatória
        global tick = tick + 1

        call lerInput()
        call atualizarLaser()
        call atualizarInimigo()
        call verificarColisoes()
        call desenharJogo()

        sleep 16
    done

    call paintAll(0, 0, 0)
    repaint
    meow ("GAME OVER!")
    purr ("Pontuacao Final: ")
    meow (score)

    sleep 2000
    exit

lerInput():
    keyboard "A"
    keyboard "D"
    keyboard "SPACE"

    :/ Move a nave para a esquerda
    if (A == 1) then:
        call mathClamp(playerX - 2.0, 0, 94) : res
        global playerX = res
    end

    :/ Move a nave para a direita
    if (D == 1) then:
        call mathClamp(playerX + 2.0, 0, 94) : res
        global playerX = res
    end

    :/ Atira se o laser não estiver ativo
    if (SPACE == 1) then:
        if (laserActive == 0) then:
            global laserActive = 1
            global laserX = playerX + 2.5
            global laserY = 42.0
        end
    end
    return

atualizarLaser():
    if (laserActive == 1) then:
        global laserY = laserY - 2.5
        :/ Se o tiro sair da tela, desativa
        if (laserY < 0) then:
            global laserActive = 0
        end
    end
    return

atualizarInimigo():
    global astY = astY + astSpeed

    :/ Se o asteroide passar do jogador e sair da tela
    if (astY >= 45) then:
        global lives = lives - 1
        call resetInimigo()
        if (lives == 0) then:
            global playing = 0
        end
    end
    return

verificarColisoes():
    :/ 1. Colisão do Laser com o Asteroide
    if (laserActive == 1) then:
        call checkCollision(laserX, laserY, 1, 2, astX, astY, 6, 4)
        if (result == 1) then:
            global score = score + 10
            global laserActive = 0
            call resetInimigo()
        end
    end

    :/ 2. Colisão do Asteroide com a Nave do Jogador
    call checkCollision(playerX, playerY, playerW, playerH, astX, astY, 6, 4)
    if (result == 1) then:
        global lives = lives - 1
        call resetInimigo()
        if (lives == 0) then:
            global playing = 0
        end
    end
    return

resetInimigo():
    :/ Usa o tick como fator de aleatoriedade para o eixo X
    var pseudoRand = tick * 31
    var rawX = pseudoRand % 80
    var nextX = rawX + 5

    global astX = nextX
    global astY = 0.0

    :/ Aumento de velocidade muito mais suave
    var speedIncr = score / 200
    global astSpeed = 0.5 + speedIncr
    return

desenharJogo():
    call paintAll(0, 0, 0)

    :/ Desenha a Nave (Verde)
    call paintRect(playerX, playerY, playerW, playerH, 50, 255, 50)
    :/ Cabine da nave
    var cabinX = playerX + 2
    var cabinY = playerY - 1
    call paintRect(cabinX, cabinY, 2, 1, 100, 255, 100)

    :/ Desenha o Laser se estiver ativo (Ciano)
    if (laserActive == 1) then:
        call paintRect(laserX, laserY, 1, 2, 50, 255, 255)
    end

    :/ Desenha o Asteroide (Vermelho/Laranja)
    call paintRect(astX, astY, 6, 4, 255, 100, 50)

    if (lives >= 1) then: call paintRect(2, 2, 2, 2, 255, 255, 255)
    if (lives >= 2) then: call paintRect(6, 2, 2, 2, 255, 255, 255)
    if (lives >= 3) then: call paintRect(10, 2, 2, 2, 255, 255, 255)

    repaint
    return